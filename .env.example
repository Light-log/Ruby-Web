NEXT_PUBLIC_BOOKING_URL=https://calendly.com/tu-usuario/consulta-inicial

# Formulario de contacto (app/api/contact/route.ts). Las seis son obligatorias:
# sin ellas el endpoint responde HTTP 500 "Falta variable de entorno: SMTP_HOST".
# En Hostinger van en hPanel > Node.js > Variables de entorno (no en este archivo).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=soporte@devruby.org
SMTP_PASS=
SMTP_FROM="DEVRUBY <soporte@devruby.org>"
CONTACT_TO=soporte@devruby.org
